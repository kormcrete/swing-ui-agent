---
// One row of <Overview>: the picture (an imported asset), its alt text, a heading, and the text in the default slot.
// A click on the picture opens `full` (the uncropped picture; the picture itself when not given) in a dialog.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	image: ImageMetadata;
	full?: ImageMetadata;
	alt: string;
	title: string;
}
const { image, full = image, alt, title } = Astro.props;
---

<li>
	<figure class="kc-overview-pic">
		<button type="button" class="kc-overview-zoom" aria-label={`Show the full picture: ${alt}`}>
			<Image src={image} alt={alt} width={560} loading="lazy" />
		</button>
		<dialog class="kc-overview-full">
			<form method="dialog">
				<button class="kc-overview-close" aria-label="Close">✕</button>
			</form>
			<Image src={full} alt={alt} width={Math.min(full.width, 1800)} loading="lazy" />
		</dialog>
	</figure>
	<div class="kc-overview-text">
		<h3>{title}</h3>
		<slot />
	</div>
</li>

<script>
	for (const zoom of document.querySelectorAll<HTMLButtonElement>('.kc-overview-zoom')) {
		const dialog = zoom.nextElementSibling as HTMLDialogElement;
		zoom.addEventListener('click', () => dialog.showModal());
		// A click anywhere in the open dialog (the picture or the dimmed page around it) closes it.
		dialog.addEventListener('click', () => dialog.close());
	}
</script>
