---
import Default from '@astrojs/starlight/components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Default><slot /></Default>
<p class="kc-credit">
	Apache-2.0 · A <a href="https://github.com/kormcrete">Kormcrete</a> project · For coding agents:
	<a href={`${base}/llms.txt`}>llms.txt</a>, <a href={`${base}/llms-full.txt`}>llms-full.txt</a>
</p>

<style>
	.kc-credit {
		margin-top: 1.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.kc-credit a {
		color: inherit;
	}
</style>
